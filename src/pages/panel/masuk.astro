---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import AdminAuth from '@/components/islands/AdminAuth';
import Check from '@lucide/astro/icons/check';

const points = ['Kelola project & progress client', 'Buat & kelola invoice', 'Semua data portal di satu tempat'];
---

<Layout title="Masuk Admin — JASAWEBSITE.co" description="Panel admin JASAWEBSITE.co." hideFooter>
  <section class="mx-auto grid min-h-[calc(100svh-6rem)] max-w-[90rem] px-5 md:grid-cols-2 md:px-10">
    <div class="flex flex-col justify-center py-14 md:pr-16">
      <p class="text-xs uppercase tracking-[0.25em] text-accent">Admin Panel</p>
      <h1 class="mt-4 max-w-md font-display text-[clamp(2rem,4.5vw,3.5rem)] font-semibold leading-[1.04] tracking-tight">
        Masuk ke panel.
      </h1>
      <p class="mt-4 max-w-sm text-muted">Kelola project &amp; invoice client dari satu tempat.</p>
      <ul class="mt-8 space-y-3">
        {points.map((x) => (
          <li class="flex items-center gap-3 text-muted">
            <Check class="h-4 w-4 shrink-0 text-accent" stroke-width={2.5} />
            {x}
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center border-t border-line py-14 md:border-l md:border-t-0 md:pl-16">
      <AdminAuth client:load initialMode="login" />
    </div>
  </section>
</Layout>
