---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getSession } from '@/lib/auth';
import { getPg } from '@/lib/pg';
import { clientUser, project, invoice, lead } from '@/db/pg-schema';
import { desc } from 'drizzle-orm/pg-core/expressions';

const env = Astro.locals.runtime.env;
const session = await getSession(env, Astro.request);
if (session?.role !== 'admin') return Astro.redirect('/panel/masuk');

type Row = Record<string, unknown>;
const db = getPg(env);
const clients: Row[] = await db.select().from(clientUser).orderBy(desc(clientUser.createdAt));
const projects: Row[] = await db.select().from(project).orderBy(desc(project.updatedAt));
const invoices: Row[] = await db.select().from(invoice).orderBy(desc(invoice.createdAt));
const leads: Row[] = await db.select().from(lead).orderBy(desc(lead.createdAt));
const byClient = (rows: Row[], id: unknown) => rows.filter((r) => r.clientId === id);
const fmtIDR = (n: unknown) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(n));
const fmtDate = (d: unknown) =>
  new Intl.DateTimeFormat('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }).format(new Date(d as string));
const waHref = (num: unknown) => 'https://wa.me/' + String(num).replace(/[^0-9]/g, '').replace(/^0/, '62');

const fld = 'w-full border-0 border-b border-line bg-transparent pb-1.5 pt-1 text-sm outline-none transition-colors placeholder:text-muted/50 focus:border-accent';
const projectStatuses = ['baru', 'proses', 'review', 'selesai'];
const invoiceStatuses = ['draft', 'terkirim', 'lunas', 'jatuh_tempo'];
const leadStatuses = ['baru', 'dihubungi', 'deal', 'arsip'];
const newLeads = leads.filter((l) => l.status === 'baru').length;
---

<Layout title="Admin Panel — JASAWEBSITE.co" description="Panel admin JASAWEBSITE.co" hideFooter>
  <section class="mx-auto max-w-[90rem] px-5 py-16 md:px-10 md:py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-[0.25em] text-accent">Admin Panel</p>
          <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight md:text-5xl">Client &amp; project</h1>
          <p class="mt-2 text-muted">
            {clients.length} client · {projects.length} project · {invoices.length} invoice ·
            <a href="#leads" class="underline-offset-4 hover:underline">{leads.length} lead{newLeads > 0 && <span class="text-accent"> ({newLeads} baru)</span>}</a>
          </p>
        </div>
        <form method="post" action="/api/panel/auth/logout" data-astro-reload>
          <button type="submit" class="rounded-full border border-line px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent">Keluar</button>
        </form>
      </div>

      {/* Pesan masuk (leads dari form kontak) */}
      <section id="leads" class="mt-14 scroll-mt-28">
        <div class="flex items-baseline justify-between border-b border-line pb-3">
          <h2 class="font-display text-2xl font-semibold">Pesan masuk</h2>
          <p class="text-sm text-muted">{leads.length} total · {newLeads} belum ditindak</p>
        </div>
        {leads.length === 0 ? (
          <p class="mt-6 text-muted">Belum ada pesan masuk dari form kontak.</p>
        ) : (
          <ul class="mt-4 space-y-3">
            {leads.map((l) => (
              <li class:list={['rounded-2xl border p-5', l.status === 'baru' ? 'border-accent/40 bg-surface/40' : 'border-line']}>
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-display text-lg font-semibold">
                      {String(l.name)}
                      {l.service ? <span class="ml-2 text-sm font-normal text-muted">· {String(l.service)}</span> : null}
                    </p>
                    <p class="mt-0.5 text-sm text-muted">
                      <a href={waHref(l.contact)} target="_blank" rel="noopener" class="text-accent underline-offset-4 hover:underline">{String(l.contact)}</a>
                      {l.email ? <span> · {String(l.email)}</span> : null}
                      {l.budgetRange ? <span> · {String(l.budgetRange)}</span> : null}
                    </p>
                  </div>
                  <time class="shrink-0 text-xs uppercase tracking-wider text-muted">{fmtDate(l.createdAt)}</time>
                </div>
                <p class="mt-3 whitespace-pre-wrap text-sm leading-relaxed text-text/90">{String(l.message)}</p>
                <form method="post" action={`/api/panel/lead/${l.id}`} data-astro-reload class="mt-4 flex flex-wrap items-center gap-2 border-t border-line pt-3 text-sm">
                  <select name="status" class="border-b border-line bg-transparent py-0.5 text-xs outline-none focus:border-accent">
                    {leadStatuses.map((s) => <option value={s} selected={s === String(l.status)}>{s}</option>)}
                  </select>
                  <button type="submit" name="_action" value="update" class="rounded-full bg-text px-3 py-1 text-xs font-medium text-bg hover:opacity-90">Simpan</button>
                  <a href={waHref(l.contact)} target="_blank" rel="noopener" class="rounded-full border border-line px-3 py-1 text-xs font-medium transition-colors hover:border-accent hover:text-accent">Balas WA</a>
                  <button type="submit" name="_action" value="delete" formnovalidate aria-label="Hapus lead" class="ml-auto rounded-full border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent">✕</button>
                </form>
              </li>
            ))}
          </ul>
        )}
      </section>

      <h2 class="mt-16 border-b border-line pb-3 font-display text-2xl font-semibold">Client</h2>
      {clients.length === 0 && <p class="mt-8 text-muted">Belum ada client terdaftar.</p>}

      <div class="mt-8 space-y-8">
        {clients.map((c) => (
          <article id={`c-${c.id}`} class="scroll-mt-28 rounded-2xl border border-line p-6 md:p-8">
            <header class="flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-4">
              <div>
                <h2 class="font-display text-xl font-semibold">{c.name}</h2>
                <p class="text-sm text-muted">{c.email}{c.company ? ` · ${c.company}` : ''}</p>
              </div>
            </header>

            <div class="mt-6 grid gap-8 md:grid-cols-2 md:gap-12">
              {/* Projects */}
              <div>
                <h3 class="text-xs uppercase tracking-[0.2em] text-muted">Project</h3>
                <ul class="mt-3 space-y-2">
                  {byClient(projects, c.id).map((p) => (
                    <li class="border-b border-line py-2.5">
                      <form method="post" action={`/api/panel/project/${p.id}`} data-astro-reload class="flex flex-wrap items-center gap-2 text-sm">
                        <input type="hidden" name="clientId" value={String(c.id)} />
                        <span class="min-w-0 flex-1 truncate font-medium">{String(p.title)}{p.service ? <span class="font-normal text-muted"> · {String(p.service)}</span> : null}</span>
                        <select name="status" class="border-b border-line bg-transparent py-0.5 text-xs outline-none focus:border-accent">
                          {projectStatuses.map((s) => <option value={s} selected={s === String(p.status)}>{s}</option>)}
                        </select>
                        <input name="progress" type="number" min="0" max="100" value={String(p.progress)} aria-label="Progress %" class="w-12 border-b border-line bg-transparent py-0.5 text-center text-xs outline-none focus:border-accent" />
                        <button type="submit" name="_action" value="update" class="rounded-full bg-text px-3 py-1 text-xs font-medium text-bg hover:opacity-90">Simpan</button>
                        <button type="submit" name="_action" value="delete" formnovalidate aria-label="Hapus project" class="rounded-full border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent">✕</button>
                      </form>
                    </li>
                  ))}
                  {byClient(projects, c.id).length === 0 && <li class="py-2 text-sm text-muted">Belum ada.</li>}
                </ul>
                <form method="post" action="/api/panel/project" data-astro-reload class="mt-4 grid grid-cols-2 gap-3">
                  <input type="hidden" name="clientId" value={String(c.id)} />
                  <input name="title" required placeholder="Judul project" class={`${fld} col-span-2`} />
                  <input name="service" placeholder="Layanan (opsional)" class={`${fld} col-span-2`} />
                  <select name="status" class={fld}>{projectStatuses.map((s) => <option value={s}>{s}</option>)}</select>
                  <input name="progress" type="number" min="0" max="100" value="0" placeholder="Progress %" class={fld} />
                  <button type="submit" class="col-span-2 mt-1 rounded-full bg-text px-4 py-2 text-sm font-medium text-bg transition-transform hover:scale-[1.02]">+ Tambah project</button>
                </form>
              </div>

              {/* Invoices */}
              <div>
                <h3 class="text-xs uppercase tracking-[0.2em] text-muted">Invoice</h3>
                <ul class="mt-3 space-y-2">
                  {byClient(invoices, c.id).map((i) => (
                    <li class="border-b border-line py-2.5">
                      <form method="post" action={`/api/panel/invoice/${i.id}`} data-astro-reload class="flex flex-wrap items-center gap-2 text-sm">
                        <input type="hidden" name="clientId" value={String(c.id)} />
                        <span class="min-w-0 flex-1 truncate"><span class="font-medium">{String(i.number)}</span> · {String(i.title)} <span class="text-muted">{fmtIDR(i.amount)}</span></span>
                        <select name="status" class="border-b border-line bg-transparent py-0.5 text-xs outline-none focus:border-accent">
                          {invoiceStatuses.map((s) => <option value={s} selected={s === String(i.status)}>{s}</option>)}
                        </select>
                        <button type="submit" name="_action" value="update" class="rounded-full bg-text px-3 py-1 text-xs font-medium text-bg hover:opacity-90">Simpan</button>
                        <button type="submit" name="_action" value="delete" formnovalidate aria-label="Hapus invoice" class="rounded-full border border-line px-2.5 py-1 text-xs text-muted transition-colors hover:border-accent hover:text-accent">✕</button>
                      </form>
                    </li>
                  ))}
                  {byClient(invoices, c.id).length === 0 && <li class="py-2 text-sm text-muted">Belum ada.</li>}
                </ul>
                <form method="post" action="/api/panel/invoice" data-astro-reload class="mt-4 grid grid-cols-2 gap-3">
                  <input type="hidden" name="clientId" value={String(c.id)} />
                  <input name="number" required placeholder="No. invoice" class={fld} />
                  <input name="amount" type="number" min="0" required placeholder="Jumlah (Rp)" class={fld} />
                  <input name="title" required placeholder="Deskripsi" class={`${fld} col-span-2`} />
                  <select name="status" class={`${fld} col-span-2`}>{invoiceStatuses.map((s) => <option value={s}>{s}</option>)}</select>
                  <button type="submit" class="col-span-2 mt-1 rounded-full bg-text px-4 py-2 text-sm font-medium text-bg transition-transform hover:scale-[1.02]">+ Tambah invoice</button>
                </form>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
</Layout>
