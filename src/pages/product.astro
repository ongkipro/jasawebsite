---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import PageHeroVideo from '@/components/PageHeroVideo.astro';
import { waLink } from '@/data/site';

const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '6282136093430');

// "Anatomi mesin yang menjual" — pembeda cara kami membangun (bukan daftar layanan/karya)
const pillars = [
  { n: '01', title: 'Strategi & struktur', body: 'Riset bisnis, kompetitor, dan alur pengunjung dulu — sebelum satu piksel dibuat.' },
  { n: '02', title: 'Desain yang mengarahkan', body: 'Setiap section punya satu tujuan. Visual menuntun mata pengunjung ke aksi.' },
  { n: '03', title: 'Cepat & ditemukan', body: 'Ngebut di semua layar, SEO teknis rapi, siap diindeks dan dibagikan.' },
  { n: '04', title: 'Tracking & iklan', body: 'Event tracking benar sejak awal — siap di-scale lewat Meta & Google Ads.' },
];
---

<Layout title="Signature — JASAWEBSITE.co" description="Signature JASAWEBSITE.co: metode membangun website & toko online yang bukan sekadar tampil, tapi jadi mesin penjualan." ogImage="/og-product.png">
  <PageHeroVideo
    title="Bukan sekadar website — mesin yang menjual."
    eyebrow="Signature"
    intro="Website & toko online yang diperlakukan sebagai mesin — dirancang untuk menggerakkan pengunjung ke aksi."
  />

  <!-- Narasi + CTA -->
  <section class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-24">
    <div class="grid gap-10 md:grid-cols-2 md:gap-16">
      <div class="space-y-5 text-lg leading-relaxed text-muted" data-reveal>
        <p>
          "Signature" kami sederhana tapi jarang dilakukan dengan benar: memperlakukan website sebagai
          <em>mesin</em>, bukan brosur. Setiap elemen dirancang untuk satu hal — menggerakkan pengunjung
          ke aksi.
        </p>
        <p>
          Kami gabungkan craft visual sekelas studio internasional dengan CRO dan iklan dalam satu tim.
          Hasilnya nyambung dari tampilan sampai penjualan.
        </p>
      </div>
      <div class="flex flex-col items-start gap-8 md:items-end md:text-right" data-reveal>
        <p class="max-w-xs font-display text-2xl font-semibold leading-snug md:text-3xl">
          Cantik yang bisa dibuktikan angkanya.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            data-magnetic
            class="btn-fill rounded-full bg-text px-7 py-3.5 font-medium text-bg"
          >
            Mulai project ↗
          </a>
          <a
            href="/layanan"
            class="rounded-full border border-line px-7 py-3.5 font-medium transition-colors hover:border-text"
          >
            Lihat layanan
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Anatomi mesin yang menjual -->
  <section class="mx-auto max-w-[90rem] px-5 md:px-10">
    <div class="border-t border-line pt-10 md:pt-14">
      <h2 class="max-w-2xl font-display text-3xl font-semibold tracking-tight md:text-5xl" data-split>
        Anatomi mesin yang menjual
      </h2>
      <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {pillars.map((p) => (
          <div class="border-t border-line pt-6">
            <span class="font-display text-2xl font-semibold text-muted">{p.n}</span>
            <h3 class="mt-5 font-display text-xl font-semibold">{p.title}</h3>
            <p class="mt-3 text-muted">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Angka pembeda -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10 md:py-28">
    <div class="grid gap-10 border-t border-line pt-10 sm:grid-cols-3 md:pt-14">
      <div>
        <p class="font-display text-5xl font-semibold md:text-6xl">3-in-1</p>
        <p class="mt-2 text-muted">Desain, CRO, &amp; iklan dalam satu tim — tanpa bola yang jatuh antar vendor.</p>
      </div>
      <div>
        <p class="font-display text-5xl font-semibold md:text-6xl"><span data-counter="7">0</span></p>
        <p class="mt-2 text-muted">Layanan spesialis, dari toko online sampai performance ads.</p>
      </div>
      <div>
        <p class="font-display text-5xl font-semibold md:text-6xl"><span data-counter="100">0</span>%</p>
        <p class="mt-2 text-muted">Fokus ke conversion — cantik yang bisa dibuktikan angkanya.</p>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="mx-auto max-w-[90rem] px-5 pb-24 md:px-10 md:pb-32">
    <blockquote class="max-w-4xl font-display text-3xl font-medium leading-[1.15] tracking-tight md:text-5xl" data-split>
      “Bukan cuma cantik — mereka paham conversion. Toko online kami siap di-scale lewat ads sejak
      hari pertama.”
    </blockquote>
    <figcaption class="mt-8 text-muted">
      <span class="font-semibold text-text">Dimas Prayoga</span> — Owner, Kopi Lereng
    </figcaption>
  </section>
</Layout>
