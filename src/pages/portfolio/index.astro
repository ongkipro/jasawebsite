---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import PageHeroVideo from '@/components/PageHeroVideo.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { works } from '@/data/site';
---

<Layout title="Portfolio — JASAWEBSITE.co" description="Karya JASAWEBSITE.co: toko online, Shopify, company profile, website sales, custom web, dan performance ads." ogImage="/og-portfolio.png">
  <PageHeroVideo
    title="Portofolio"
    eyebrow="Karya pilihan"
    intro="Sebagian karya yang kami kerjakan lintas toko online, Shopify, company profile, website sales, custom web, sampai performance ads."
  />
  <section class="mx-auto max-w-[90rem] px-5 pb-24 pt-14 md:px-10 md:pb-32 md:pt-20">
    <WorkGrid works={works} />
  </section>
</Layout>
