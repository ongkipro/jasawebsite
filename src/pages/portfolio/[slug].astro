---
// Case study (PRD §8.3): Challenge → Approach → Solusi → Hasil
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import { works, waLink } from '@/data/site';

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}

const { work } = Astro.props;
const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '62800000000');
const next = works[(works.findIndex((w) => w.slug === work.slug) + 1) % works.length];
---

<Layout title={`${work.title} — Portfolio JASAWEBSITE.co`} description={work.result ?? work.title}>
  <article class="mx-auto max-w-4xl px-5 py-20">
    <p class="text-xs uppercase tracking-widest text-accent">{work.category}</p>
    <h1 class="mt-4 text-display" data-hero>
      <span class="mask-line"><span>{work.title}</span></span>
    </h1>
    <p class="mt-6 text-muted" data-reveal>Klien: {work.client}</p>

    <div class="mt-12 flex aspect-video items-center justify-center rounded-xl bg-surface" data-reveal>
      <p class="text-muted">TODO: media hero case study</p>
    </div>

    <!-- TODO: isi konten Challenge → Approach → Solusi → Hasil dari CMS -->
    <section class="mt-12 space-y-8" data-reveal>
      <div>
        <h2 class="font-display text-2xl font-semibold text-muted">Hasil</h2>
        <p class="mt-3 text-lg">{work.result}</p>
      </div>
    </section>

    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-surface pt-8" data-reveal>
      {next && next.slug !== work.slug && (
        <a href={`/portfolio/${next.slug}`} class="text-accent hover:underline">
          Case berikutnya: {next.title} →
        </a>
      )}
      <a
        href={wa}
        target="_blank"
        rel="noopener"
        class="rounded-full bg-wa px-6 py-3 font-medium text-bg transition-transform hover:scale-105"
      >
        Mau hasil seperti ini?
      </a>
    </div>
  </article>
</Layout>
