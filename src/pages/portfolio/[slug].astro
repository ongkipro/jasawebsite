---
// Case study (PRD §8.3): hero → meta → cover → hasil → tantangan/pendekatan/deliverables → next
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import Button from '@/components/Button.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { works, services, waLink } from '@/data/site';
import Check from '@lucide/astro/icons/check';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

export function getStaticPaths() {
  return works.map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}

const { work } = Astro.props;
const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '6282136093430');
const idx = works.findIndex((w) => w.slug === work.slug);
const next = works[(idx + 1) % works.length];

// Judul dipecah: brand (h1) + deskriptor (subjudul) — headline tidak lagi kebesaran
const brand = work.title.split('—')[0].trim();
const descriptor = work.title.split('—')[1]?.trim();

// Petakan kategori karya → layanan, lalu pakai konten layanan sebagai isi case study
const catToService: Record<string, string> = {
  'Toko Online': 'website-toko-online',
  Shopify: 'shopify-development',
  'Company Profile': 'company-profile',
  'Website Sales': 'website-sales',
  'Custom Web': 'custom-web',
  'Performance Ads': 'meta-ads',
};
const service = services.find((s) => s.slug === catToService[work.category]);

const meta = [
  { label: 'Klien', value: work.client },
  { label: 'Tahun', value: work.year ?? '—' },
  { label: 'Layanan', value: work.category, href: service ? `/layanan/${service.slug}` : undefined },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://jasawebsite.co/' },
        { '@type': 'ListItem', position: 2, name: 'Portofolio', item: 'https://jasawebsite.co/portfolio' },
        { '@type': 'ListItem', position: 3, name: brand },
      ],
    },
    {
      '@type': 'CreativeWork',
      name: work.title,
      about: work.category,
      description: work.result ?? work.title,
      creator: { '@id': 'https://jasawebsite.co/#org' },
      ...(work.cover ? { image: work.cover } : {}),
    },
  ],
};
---

<Layout title={`${brand} — Portofolio JASAWEBSITE.co`} description={work.result ?? `Studi kasus ${work.title} oleh JASAWEBSITE.co.`} ogImage="/og-portfolio.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-24">
    <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Portofolio', href: '/portfolio' }, { label: brand }]} />

    <header class="mt-6 max-w-4xl">
      <p class="text-xs uppercase tracking-[0.25em] text-accent">{work.category}</p>
      <h1
        class="mt-3 font-display text-[clamp(2.25rem,5vw,4rem)] font-semibold leading-[1.03] tracking-tight"
        data-split-hero
      >
        {brand}
      </h1>
      {descriptor && <p class="mt-4 text-xl text-muted md:text-2xl">{descriptor}</p>}
    </header>

    <!-- Meta -->
    <dl class="mt-10 grid gap-6 border-y border-line py-6 sm:grid-cols-3">
      {meta.map((m) => (
        <div>
          <dt class="text-xs uppercase tracking-[0.15em] text-muted">{m.label}</dt>
          <dd class="mt-1 font-medium">
            {m.href ? (
              <a href={m.href} class="group inline-flex items-center gap-1 transition-colors hover:text-accent">
                {m.value}
                <ArrowUpRight class="h-3.5 w-3.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" stroke-width={2} />
              </a>
            ) : (
              m.value
            )}
          </dd>
        </div>
      ))}
    </dl>

    <!-- Cover -->
    <div class="po-media mt-12 aspect-[16/9]" data-reveal-img>
      <img class="po-img" src={work.cover} alt={`Karya ${work.title}`} data-parallax="0.08" width="1200" height="675" />
    </div>

    <!-- Hasil (highlight) -->
    {work.result && (
      <div class="mt-12 border-l-2 border-accent pl-6 md:mt-16 md:pl-8">
        <p class="text-xs uppercase tracking-[0.2em] text-muted">Hasil</p>
        <p class="mt-2 max-w-3xl font-display text-2xl font-semibold leading-snug md:text-4xl">{work.result}</p>
      </div>
    )}

    <div class="mt-16 grid gap-12 md:mt-20 md:grid-cols-[1fr_auto] md:gap-16">
      <div class="max-w-2xl space-y-12">
        {service && (
          <>
            <section data-reveal>
              <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Tantangan</h2>
              <p class="mt-3 text-lg leading-relaxed">{service.problem}</p>
            </section>
            <section data-reveal>
              <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Pendekatan kami</h2>
              <p class="mt-3 text-lg leading-relaxed">{service.solution}</p>
            </section>
            <section data-reveal>
              <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Yang kami kerjakan</h2>
              <ul class="mt-5 space-y-3">
                {service.deliverables.map((d) => (
                  <li class="flex items-start gap-3">
                    <Check class="mt-1 h-4 w-4 shrink-0 text-accent" stroke-width={2.5} />
                    <span class="text-lg">{d}</span>
                  </li>
                ))}
              </ul>
            </section>
          </>
        )}

        {work.tags && work.tags.length > 0 && (
          <div class="flex flex-wrap gap-2" data-reveal>
            {work.tags.map((t) => (
              <span class="rounded-full border border-line px-3 py-1 text-xs text-muted">{t}</span>
            ))}
          </div>
        )}
      </div>

      <!-- CTA -->
      <aside class="md:w-72">
        <div class="rounded-2xl bg-surface p-8 md:sticky md:top-28">
          <p class="font-display text-xl font-semibold leading-snug">Mau hasil seperti ini untuk bisnis Anda?</p>
          <p class="mt-3 text-sm text-muted">Konsultasi gratis — kami bantu petakan langkah pertama.</p>
          <div class="mt-6">
            <Button href={wa} magnetic external>Mulai obrolan</Button>
          </div>
        </div>
      </aside>
    </div>

    <!-- Next -->
    {next && next.slug !== work.slug && (
      <a
        href={`/portfolio/${next.slug}`}
        class="group mt-20 flex items-center justify-between gap-4 border-t border-line pt-8"
      >
        <span>
          <span class="text-xs uppercase tracking-[0.2em] text-muted">Karya berikutnya</span>
          <span class="mt-1 block font-display text-2xl font-semibold transition-colors group-hover:text-accent md:text-3xl">
            {next.title.split('—')[0].trim()}
          </span>
        </span>
        <ArrowUpRight class="h-7 w-7 shrink-0 text-muted transition-transform group-hover:-translate-y-1 group-hover:translate-x-1" stroke-width={1.75} />
      </a>
    )}
  </article>
</Layout>
