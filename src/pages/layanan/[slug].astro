---
// Halaman detail layanan (PRD §8.2): meta → problem → solusi → deliverables → bukti → CTA
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import { services, works, waLink } from '@/data/site';
import Check from '@lucide/astro/icons/check';
import Wallet from '@lucide/astro/icons/wallet';
import Clock from '@lucide/astro/icons/clock';
import Target from '@lucide/astro/icons/target';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '6282136093430', service.title);
const relatedWork = works.find((w) => w.category.toLowerCase().includes(service.slug.split('-')[0]));

const meta = [
  { icon: Wallet, label: 'Harga', value: service.priceFrom ?? 'Hubungi kami' },
  { icon: Clock, label: 'Estimasi', value: service.timeline ?? '—' },
  { icon: Target, label: 'Cocok untuk', value: service.idealFor ?? '—' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: service.title,
      description: service.short,
      provider: { '@id': 'https://jasawebsite.co/#org' },
      areaServed: 'ID',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://jasawebsite.co/' },
        { '@type': 'ListItem', position: 2, name: 'Layanan', item: 'https://jasawebsite.co/layanan' },
        { '@type': 'ListItem', position: 3, name: service.title },
      ],
    },
  ],
};
---

<Layout title={`${service.title} — JASAWEBSITE.co`} description={service.short} ogImage="/og-layanan.png">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-24">
    <Breadcrumb items={[{ label: 'Beranda', href: '/' }, { label: 'Layanan', href: '/layanan' }, { label: service.title }]} />
    <div class="mt-6">
      <PageHero
        title={service.title}
        eyebrow={service.type === 'retainer' ? 'Retainer bulanan' : 'Project'}
        intro={service.short}
      />
    </div>

    <!-- Meta: harga / estimasi / cocok untuk -->
    <dl class="mt-12 grid gap-6 border-y border-line py-8 sm:grid-cols-3">
      {meta.map((m) => (
        <div class="flex items-start gap-3">
          <m.icon class="mt-0.5 h-5 w-5 shrink-0 text-muted" stroke-width={1.5} />
          <div>
            <dt class="text-xs uppercase tracking-[0.15em] text-muted">{m.label}</dt>
            <dd class="mt-1 font-medium leading-snug">{m.value}</dd>
          </div>
        </div>
      ))}
    </dl>

    <div class="mt-16 grid gap-12 md:grid-cols-[1fr_auto] md:gap-16">
      <div class="max-w-2xl space-y-12">
        <section data-reveal>
          <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Masalahnya</h2>
          <p class="mt-3 text-lg leading-relaxed">{service.problem}</p>
        </section>

        <section data-reveal>
          <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Solusi kami</h2>
          <p class="mt-3 text-lg leading-relaxed">{service.solution}</p>
        </section>

        <section data-reveal>
          <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Yang Anda dapat</h2>
          <ul class="mt-5 space-y-3">
            {service.deliverables.map((d) => (
              <li class="flex items-start gap-3">
                <Check class="mt-1 h-4 w-4 shrink-0 text-accent" stroke-width={2.5} />
                <span class="text-lg">{d}</span>
              </li>
            ))}
          </ul>
        </section>

        {relatedWork && (
          <section data-reveal>
            <h2 class="text-xs uppercase tracking-[0.2em] text-muted">Bukti karya</h2>
            <a
              href={`/portfolio/${relatedWork.slug}`}
              class="group mt-4 flex items-baseline justify-between gap-4 border-b border-line py-4 transition-colors hover:border-accent"
            >
              <span>
                <span class="font-display text-xl font-semibold transition-colors group-hover:text-accent">
                  {relatedWork.title.split('—')[0].trim()}
                </span>
                <span class="mt-1 block text-sm text-muted">{relatedWork.result}</span>
              </span>
              <ArrowUpRight class="h-5 w-5 shrink-0 text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" stroke-width={2} />
            </a>
          </section>
        )}
      </div>

      <!-- CTA -->
      <aside class="md:w-72">
        <div class="rounded-2xl bg-surface p-8 md:sticky md:top-28">
          <p class="text-xs uppercase tracking-[0.15em] text-muted">Mulai dari</p>
          <p class="mt-1 font-display text-2xl font-semibold">{service.priceFrom ?? 'Hubungi kami'}</p>
          <p class="mt-4 text-sm text-muted">
            Konsultasi gratis — ceritakan kebutuhan Anda, kami rekomendasikan paket paling pas.
          </p>
          <div class="mt-6">
            <Button href={wa} magnetic external>Diskusi via WhatsApp</Button>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
