---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import PageHeroVideo from '@/components/PageHeroVideo.astro';
import { services } from '@/data/site';
import Check from '@lucide/astro/icons/check';

// 7 layanan dikelompokkan jadi 3 kategori editorial (pola Hello Monday /services)
const groups = [
  {
    id: 'toko-online',
    eyebrow: 'Kami bikin',
    title: 'Toko Online',
    body: 'Toko online yang benar-benar siap jualan — dari storefront custom sampai Shopify premium. Cepat, rapi, dan dirancang untuk di-scale lewat iklan sejak hari pertama.',
    includes: ['Katalog & keranjang siap jual', 'Checkout + payment gateway', 'Siap dihubungkan ke iklan'],
    serviceSlugs: ['website-toko-online', 'shopify-development'],
  },
  {
    id: 'website',
    eyebrow: 'Kami bangun',
    title: 'Website',
    body: 'Company profile yang membangun kepercayaan, landing page yang menjual, sampai web app custom. Dieksekusi presisi dan cepat di semua layar.',
    includes: ['Struktur & copy yang mengarahkan', 'Cepat & rapi di semua layar', 'SEO teknis dasar'],
    serviceSlugs: ['company-profile', 'website-sales', 'custom-web'],
  },
  {
    id: 'iklan',
    eyebrow: 'Kami kembangkan',
    title: 'Iklan & Growth',
    body: 'Meta Ads & Google Ads yang dikelola dengan benar — tracking akurat, kreatif yang perform, dan laporan yang mudah dibaca. Fokus ke angka, bukan sekadar impresi.',
    includes: ['Setup tracking & pixel', 'Kreatif & copy iklan', 'Laporan mingguan yang jelas'],
    serviceSlugs: ['meta-ads', 'google-ads'],
  },
].map((g, i) => ({
  ...g,
  n: String(i + 1).padStart(2, '0'),
  svcs: g.serviceSlugs.map((s) => services.find((x) => x.slug === s)).filter(Boolean),
}));
---

<Layout title="Layanan — JASAWEBSITE.co" description="Toko online, website, dan iklan performa — craft visual kelas dunia dieksekusi untuk conversion bisnis Indonesia." ogImage="/og-layanan.png">
  <PageHeroVideo
    title="Yang kami kerjakan"
    eyebrow="Layanan"
    intro="Kami bantu bisnis Indonesia tumbuh — lewat website, toko online, dan iklan yang menghubungkan brand ke pelanggannya. Craft visual kelas dunia, dieksekusi untuk conversion."
  />
  <section class="mx-auto max-w-[90rem] px-5 pb-24 pt-14 md:px-10 md:pb-28 md:pt-20">
    <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <span class="text-muted">Lompat ke</span>
      {groups.map((g) => (
        <a href={`#${g.id}`} data-jump class="link-line">{g.title}</a>
      ))}
    </nav>

    <div class="mt-16 space-y-20 md:mt-24 md:space-y-28">
      {groups.map((g) => (
        <article id={g.id} class="grid scroll-mt-28 gap-8 border-t border-line pt-10 md:grid-cols-[13rem_1fr] md:gap-12 md:pt-14">
          <div class="md:sticky md:top-28 md:self-start">
            <p class="font-display text-sm text-muted">{g.n}</p>
            <p class="mt-2 text-xs uppercase tracking-[0.25em] text-accent">{g.eyebrow}</p>
          </div>

          <div>
            <h2 class="font-display text-5xl font-semibold leading-[0.95] tracking-tight md:text-7xl" data-split>
              {g.title}
            </h2>
            <p class="mt-6 max-w-xl text-lg text-muted">{g.body}</p>

            <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
              {g.includes.map((inc) => (
                <li class="flex items-center gap-2 text-sm text-muted">
                  <Check class="h-4 w-4 shrink-0 text-accent" stroke-width={2.5} />
                  {inc}
                </li>
              ))}
            </ul>

            <ul class="mt-10 border-t border-line">
              {g.svcs.map((s) => (
                <li>
                  <a
                    href={`/layanan/${s!.slug}`}
                    class="group grid gap-1 border-b border-line py-5 transition-colors duration-300 hover:border-accent md:grid-cols-[1fr_auto] md:items-baseline md:gap-6"
                  >
                    <div>
                      <h3 class="font-display text-xl font-semibold transition-colors duration-300 group-hover:text-accent md:text-2xl">
                        {s!.title}
                      </h3>
                      <p class="mt-1 max-w-lg text-sm text-muted">{s!.short}</p>
                    </div>
                    <div class="flex items-center gap-4 text-sm">
                      {s!.priceFrom && <span class="text-muted">{s!.priceFrom}</span>}
                      <span class="text-muted transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">↗</span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-jump]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const el = document.querySelector(a.getAttribute('href'));
        if (!el) return;
        e.preventDefault();
        const w = /** @type {any} */ (window);
        if (w.__lenis) w.__lenis.scrollTo(el, { offset: -100 });
        else el.scrollIntoView({ behavior: 'smooth' });
      });
    });
  </script>
</Layout>
