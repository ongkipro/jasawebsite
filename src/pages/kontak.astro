---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import PageHeroVideo from '@/components/PageHeroVideo.astro';
import ContactForm from '@/components/islands/ContactForm';
import { site, waLink } from '@/data/site';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '6282136093430');
---

<Layout title="Kontak — JASAWEBSITE.co" description="Konsultasi gratis: ceritakan kebutuhan website atau ads Anda — kami balas dalam 1×24 jam kerja." ogImage="/og-kontak.png">
  <PageHeroVideo
    title="Ngobrol yuk."
    eyebrow="Konsultasi gratis"
    intro="Ceritakan kebutuhan Anda — website, toko online, atau iklan. Kami balas dalam 1×24 jam kerja."
  />
  <section class="mx-auto max-w-[90rem] px-5 pb-24 pt-14 md:px-10 md:pb-28 md:pt-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr] md:gap-16">
      <div data-reveal>
        <ContactForm client:visible />
      </div>

      <aside class="flex flex-col gap-8 md:border-l md:border-line md:pl-12">
        <div class="flex items-start gap-4" data-reveal>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface">
            <MessageCircle class="h-5 w-5" stroke-width={1.75} />
          </span>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">Cara tercepat</p>
            <a
              href={wa}
              target="_blank"
              rel="noopener"
              class="group mt-1 inline-flex items-center gap-1 font-display text-xl font-semibold transition-colors hover:text-accent"
            >
              Chat WhatsApp
              <ArrowUpRight class="h-4 w-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" stroke-width={2} />
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4" data-reveal>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface">
            <Mail class="h-5 w-5" stroke-width={1.75} />
          </span>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">Email</p>
            <a
              href={`mailto:${site.email}`}
              class="mt-1 inline-block font-display text-xl font-semibold transition-colors hover:text-accent"
            >
              {site.email}
            </a>
          </div>
        </div>

        <div class="flex items-start gap-4" data-reveal>
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-surface">
            <MapPin class="h-5 w-5" stroke-width={1.75} />
          </span>
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">Kantor</p>
            <p class="mt-1 font-medium">London, UK &amp; Surabaya, Indonesia</p>
            <p class="text-sm text-muted">Meeting offline dengan perjanjian.</p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
