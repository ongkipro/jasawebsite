---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import PageHeroVideo from '@/components/PageHeroVideo.astro';
import { site } from '@/data/site';

const offices = [
  {
    city: 'London',
    country: 'United Kingdom',
    lines: ['71-75 Shelton Street', 'Covent Garden, WC2H 9JQ'],
  },
  {
    city: 'Surabaya',
    country: 'Indonesia',
    lines: ['Meeting offline oleh tim marketing', 'dengan perjanjian'],
  },
];

// "Code of Honor" ala Hello Monday → prinsip kerja kami
const principles = [
  { title: 'Cantik yang menjual', body: 'Craft visual bukan tujuan akhir — ia alat. Setiap keputusan desain kami timbang dampaknya ke conversion.' },
  { title: 'Satu atap', body: 'Desain, development, CRO, dan iklan dalam satu tim. Tidak ada bola yang jatuh di antara vendor.' },
  { title: 'Transparan & terukur', body: 'Scope jelas, harga jelas, laporan yang mudah dibaca. Anda selalu tahu ke mana budget mengalir.' },
  { title: 'Cepat itu fitur', body: 'Website ngebut = pengalaman lebih baik, SEO lebih kuat, dan konversi lebih tinggi. Bukan tawar-menawar.' },
  { title: 'Ngerti pasar lokal', body: 'Craft sekelas internasional, tapi paham perilaku dan bahasa pelanggan di Indonesia.' },
  { title: 'Jujur soal ekspektasi', body: 'Kami bilang apa adanya — yang realistis, yang butuh waktu, dan yang tidak kami janjikan.' },
];
---

<Layout title="Tentang — JASAWEBSITE.co" description="JASAWEBSITE.co by VOLUM — studio web yang menggabungkan craft visual internasional dengan fokus conversion untuk bisnis Indonesia." ogImage="/og-tentang.png">
  <PageHeroVideo
    title="Siapa kami"
    eyebrow="Tentang"
    intro="Kami studio web di bawah VOLUM — percaya website yang bagus bukan cuma indah dilihat, tapi harus bekerja: mendatangkan lead, menjual produk, membangun kepercayaan."
  />
  <section class="mx-auto max-w-[90rem] px-5 pb-24 pt-14 md:px-10 md:pb-28 md:pt-20">
    <div class="max-w-2xl space-y-6 text-lg leading-relaxed text-muted" data-reveal>
      <p>
        Kami menggabungkan dua hal yang jarang ada dalam satu tim: craft visual sekelas studio
        internasional (motion, interaksi, detail) dan eksekusi ROI-driven (CRO, Meta Ads, Google Ads,
        SEO) — untuk bisnis di Indonesia.
      </p>
      <p>
        Studio "artsy" kuat visual tapi lemah conversion. Agency biasa murah tapi generik. Kami ada di
        antaranya, dan sengaja begitu.
      </p>
    </div>

    <!-- Kantor (ala Hello Monday /about) -->
    <div class="mt-24 grid gap-8 border-t border-line pt-10 md:grid-cols-[13rem_1fr] md:gap-12 md:pt-14">
      <p class="text-xs uppercase tracking-[0.25em] text-accent md:sticky md:top-28 md:self-start">Kantor</p>
      <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {offices.map((o) => (
          <div>
            <h2 class="font-display text-4xl font-semibold tracking-tight md:text-5xl">{o.city}</h2>
            <p class="mt-1 text-sm uppercase tracking-wider text-muted">{o.country}</p>
            <div class="mt-4 text-muted">
              {o.lines.map((l) => <p>{l}</p>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Prinsip (Code of Honor) -->
    <div class="mt-24 grid gap-8 border-t border-line pt-10 md:grid-cols-[13rem_1fr] md:gap-12 md:pt-14">
      <div class="md:sticky md:top-28 md:self-start">
        <p class="text-xs uppercase tracking-[0.25em] text-accent">Prinsip kami</p>
        <p class="mt-3 max-w-[12rem] text-sm text-muted">Cara kami mengambil keputusan setiap hari.</p>
      </div>
      <dl class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
        {principles.map((p) => (
          <div class="border-t border-line pt-5">
            <dt class="font-display text-xl font-semibold">{p.title}</dt>
            <dd class="mt-2 text-muted">{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Angka -->
    <div class="mt-24 grid gap-8 border-t border-line pt-10 md:grid-cols-[13rem_1fr] md:gap-12 md:pt-14">
      <p class="text-xs uppercase tracking-[0.25em] text-accent md:sticky md:top-28 md:self-start">Sekilas</p>
      <div class="flex flex-wrap gap-x-16 gap-y-8">
        <div>
          <p class="font-display text-5xl font-semibold"><span data-counter="7">0</span></p>
          <p class="mt-1 text-sm text-muted">Layanan spesialis</p>
        </div>
        <div>
          <p class="font-display text-5xl font-semibold"><span data-counter="2">0</span></p>
          <p class="mt-1 text-sm text-muted">Kota (London &amp; Surabaya)</p>
        </div>
        <div>
          <p class="font-display text-5xl font-semibold"><span data-counter="100">0</span>%</p>
          <p class="mt-1 text-sm text-muted">Fokus conversion</p>
        </div>
      </div>
    </div>
  </section>

</Layout>
