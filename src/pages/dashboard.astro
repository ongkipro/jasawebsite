---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getSession } from '@/lib/auth';
import { getPg } from '@/lib/pg';
import { clientUser, project, invoice } from '@/db/pg-schema';
import { eq, desc } from 'drizzle-orm/pg-core/expressions';

const env = Astro.locals.runtime.env;
const session = await getSession(env, Astro.request);
if (!session || session.role !== 'client') return Astro.redirect('/masuk');

const db = getPg(env);
const [me] = await db.select().from(clientUser).where(eq(clientUser.id, session.userId)).limit(1);
if (!me) return Astro.redirect('/masuk');

const projects = await db
  .select()
  .from(project)
  .where(eq(project.clientId, session.userId))
  .orderBy(desc(project.updatedAt));
const invoices = await db
  .select()
  .from(invoice)
  .where(eq(invoice.clientId, session.userId))
  .orderBy(desc(invoice.createdAt));

const fmtIDR = (n: string | number) =>
  new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(n));

const statusLabel: Record<string, string> = { baru: 'Baru', proses: 'Proses', review: 'Review', selesai: 'Selesai' };
const invLabel: Record<string, string> = { draft: 'Draft', terkirim: 'Terkirim', lunas: 'Lunas', jatuh_tempo: 'Jatuh tempo' };
---

<Layout title="Dashboard — JASAWEBSITE.co" description="Portal client JASAWEBSITE.co.">
  <section class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.25em] text-accent">Dashboard</p>
        <h1 class="mt-3 font-display text-[clamp(2rem,5vw,3.5rem)] font-semibold tracking-tight">
          Halo, {me.name.split(' ')[0]}.
        </h1>
        {me.company && <p class="mt-2 text-muted">{me.company}</p>}
      </div>
      <button
        id="logout"
        type="button"
        class="rounded-full border border-line px-5 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
      >
        Keluar
      </button>
    </div>

    <!-- Project -->
    <h2 class="mt-16 font-display text-2xl font-semibold">Project Anda</h2>
    {projects.length ? (
      <ul class="mt-6 grid gap-4 md:grid-cols-2">
        {projects.map((p) => (
          <li class="rounded-2xl border border-line p-6">
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-xl font-semibold">{p.title}</h3>
              <span class="shrink-0 text-xs uppercase tracking-wider text-muted">{statusLabel[p.status]}</span>
            </div>
            {p.service && <p class="mt-1 text-sm text-muted">{p.service}</p>}
            <div class="mt-4 h-2 overflow-hidden rounded-full bg-surface">
              <div class="h-full rounded-full bg-accent" style={`width:${p.progress}%`}></div>
            </div>
            <p class="mt-2 text-sm text-muted">{p.progress}% selesai</p>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 text-muted">
        Belum ada project. Progress akan tampil di sini setelah project Anda dimulai.
      </p>
    )}

    <!-- Invoice -->
    <h2 class="mt-16 font-display text-2xl font-semibold">Invoice</h2>
    {invoices.length ? (
      <ul class="mt-6 divide-y divide-line border-y border-line">
        {invoices.map((inv) => (
          <li class="flex flex-wrap items-baseline justify-between gap-2 py-4">
            <div>
              <p class="font-medium">{inv.title}</p>
              <p class="text-sm text-muted">{inv.number}</p>
            </div>
            <div class="text-right">
              <p class="font-display font-semibold">{fmtIDR(inv.amount)}</p>
              <p class="text-xs uppercase tracking-wider text-muted">{invLabel[inv.status]}</p>
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-6 text-muted">Belum ada invoice.</p>
    )}
  </section>

  <script is:inline>
    document.getElementById('logout')?.addEventListener('click', async () => {
      await fetch('/api/client/auth/logout', { method: 'POST' });
      location.href = '/masuk';
    });
  </script>
</Layout>
