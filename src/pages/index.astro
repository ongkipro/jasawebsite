---
// HOME — struktur & interaksi ala Hello Monday, copy Bahasa Indonesia (PRD §8.1)
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { services, works, waLink } from '@/data/site';

const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '6282136093430');

// Hero video — file lokal di /public/hero.mp4 (tidak lagi hotlink).
// ⚠️ Masih placeholder feel Hello Monday — ganti dengan showreel sendiri sebelum launch.
const DUMMY_VIDEO = '/hero.mp4';

// Kata raksasa yang berganti di hero (mirror "Branding/Websites/…" Hello Monday)
const cycleWords = [
  'Toko Online', 'Shopify', 'Company Profile',
  'Website Sales', 'Custom Web', 'Meta Ads', 'Google Ads',
];

// Brand strip — logo wall klien (dummy). ⚠️ ganti dengan logo klien asli nanti.
const brands = [
  'Batik Nusantara', 'Kopi Lereng', 'Aurora Clinic', 'TaniJaya',
  'Velora', 'PetCue', 'Sinar Jaya', 'Rumah Kriya',
];

// Portofolio (masonry via WorkGrid) — teaser 9 karya di homepage; semua 15 di /portfolio
const items = works.slice(0, 9);

// Cara kami kerja — 3 langkah sederhana
const steps = [
  {
    n: '01',
    title: 'Kenali & rencanakan',
    body: 'Kami pelajari bisnis, target, dan kompetitor Anda — lalu susun strategi & struktur yang jelas sebelum satu piksel pun dibuat.',
  },
  {
    n: '02',
    title: 'Desain & bangun',
    body: 'Desain visual kelas dunia dieksekusi jadi website cepat, rapi di semua layar, dan siap dikonversi — bukan sekadar cantik.',
  },
  {
    n: '03',
    title: 'Luncurkan & kembangkan',
    body: 'Kami rilis, pasang tracking yang benar, lalu bantu scale lewat SEO dan iklan Meta/Google dengan laporan yang mudah dibaca.',
  },
];

// Testimoni klien (DUMMY — ganti dengan testimoni asli sebelum launch)
const testimonials = [
  {
    quote: 'Website baru kami langsung terasa beda. Lead yang masuk naik dan tim sales jauh lebih gampang closing.',
    name: 'Rani Kusuma',
    role: 'Founder, Batik Nusantara',
  },
  {
    quote: 'Bukan cuma cantik — mereka paham conversion. Toko online kami siap di-scale lewat ads sejak hari pertama.',
    name: 'Dimas Prayoga',
    role: 'Owner, Kopi Lereng',
  },
  {
    quote: 'Prosesnya rapi, komunikatif, dan tepat waktu. Hasilnya sekelas brand internasional tapi tetap ngerti pasar lokal.',
    name: 'Aulia Rahman',
    role: 'Marketing Lead, Aurora Clinic',
  },
];
---

<Layout>
  <!-- 1. HERO — video background + kata raksasa yang berganti (ala Hello Monday) -->
  <section class="mx-auto max-w-[90rem] px-5 pt-4 md:px-10" data-cursor="Showreel">
    <div class="hero-stage relative flex min-h-[76vh] flex-col justify-end overflow-hidden rounded-2xl md:min-h-[82vh] md:rounded-3xl">
      <video
        src={DUMMY_VIDEO}
        poster="/hero-poster.webp"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        class="absolute inset-0 h-full w-full scale-125 object-cover"
        data-parallax="0.15"
      ></video>
      <div class="hero-scrim absolute inset-0"></div>

      <div class="relative p-6 pb-8 md:p-12 md:pb-14">
        <p class="font-display text-xl font-medium text-text/70 md:text-3xl" data-hero-in>
          Kami bikin…
        </p>
        <h1
          class="hero-cycle text-display"
          data-cycle
          aria-label={`Kami bikin ${cycleWords.join(', ')}`}
        >
          {cycleWords.map((w, i) => (
            <span class:list={['cycle-word', i === 0 && 'text-accent']} aria-hidden="true">{w}</span>
          ))}
        </h1>
        <div class="mt-6 flex flex-wrap items-center gap-6" data-hero-in>
          <p class="max-w-md text-lg text-text/80">
            Studio web untuk bisnis Indonesia — craft visual internasional,
            dieksekusi untuk conversion.
          </p>
          <a
            href={wa}
            target="_blank"
            rel="noopener"
            data-magnetic
            class="btn-fill rounded-full bg-text px-7 py-3.5 font-medium text-bg"
          >
            Mulai project ↗
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. BRAND STRIP — logo wall klien yang berjalan (velocity-reactive) -->
  <section class="mt-14 border-y border-line py-8 md:mt-20" aria-label="Klien kami">
    <p class="mb-6 text-center text-xs uppercase tracking-[0.25em] text-muted">Dipercaya oleh</p>
    <div class="overflow-hidden" data-marquee data-speed="0.5" aria-hidden="true">
      <div class="marquee-track">
        {[0, 1].map(() => (
          <div class="flex shrink-0 items-center">
            {brands.map((b) => (
              <span class="brand-mark">{b}</span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. PORTOFOLIO — masonry berantakan (komponen WorkGrid) -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10 md:py-32">
    <SectionHeading title="Portofolio" href="/portfolio" linkLabel="Semua karya ↗" />
    <WorkGrid works={items} />
    <a href="/portfolio" class="link-line mt-8 inline-block text-sm md:hidden">Semua karya ↗</a>
  </section>

  <!-- 4. YANG KAMI KERJAKAN — baris besar editorial -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10">
    <SectionHeading title="Yang kami kerjakan" href="/layanan" linkLabel="Semua layanan ↗" />

    <ul class="mt-12 border-t border-line" data-stagger>
      {services.map((s, i) => (
        <li>
          <a
            href={`/layanan/${s.slug}`}
            class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-5 border-b border-line py-6 transition-colors duration-300 hover:border-accent md:gap-8"
          >
            <span class="svc-num text-sm text-muted transition-colors duration-300 group-hover:text-accent">
              0{i + 1}
            </span>
            <span class="font-display text-2xl font-semibold transition-[transform,color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:translate-x-3 group-hover:text-accent md:text-4xl">
              {s.title}
            </span>
            <span class="flex items-center gap-4 md:gap-6">
              <span class="hidden text-xs uppercase tracking-[0.15em] text-muted transition-colors duration-300 group-hover:text-text md:inline">
                {s.type === 'retainer' ? 'Retainer' : 'Project'}
              </span>
              <span
                class="text-muted transition-[transform,color] duration-300 group-hover:translate-x-1 group-hover:text-accent"
                aria-hidden="true"
              >↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 6. CARA KAMI KERJA — 3 langkah -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10">
    <SectionHeading title="Cara kami kerja" />
    <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3" data-reveal>
      {steps.map((step) => (
        <div class="border-t border-line pt-6">
          <span class="font-display text-2xl font-semibold text-accent">{step.n}</span>
          <h3 class="mt-6 font-display text-2xl font-semibold">{step.title}</h3>
          <p class="mt-3 text-muted">{step.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 7. KENAPA KAMI + statistik -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10">
    <div class="grid gap-12 md:grid-cols-2">
      <h2 class="font-display text-3xl font-semibold tracking-tight md:text-5xl" data-split>
        Satu tim untuk craft, conversion, dan iklan.
      </h2>
      <div class="space-y-6" data-reveal>
        <p class="text-lg text-muted">
          Studio "artsy" kuat visual tapi lemah conversion. Agency biasa murah tapi generik.
          Kami menggabungkan keduanya — desain, CRO, dan ads dalam satu atap, jadi hasilnya nyambung dari tampilan sampai penjualan.
        </p>
        <div class="flex flex-wrap gap-x-12 gap-y-6">
          <div>
            <p class="font-display text-4xl font-semibold"><span data-counter="7">0</span></p>
            <p class="mt-1 text-sm text-muted">Layanan spesialis</p>
          </div>
          <div>
            <p class="font-display text-4xl font-semibold"><span data-counter="3">0</span></p>
            <p class="mt-1 text-sm text-muted">Langkah kerja</p>
          </div>
          <div>
            <p class="font-display text-4xl font-semibold"><span data-counter="100">0</span>%</p>
            <p class="mt-1 text-sm text-muted">Fokus conversion</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. TESTIMONI — social proof editorial -->
  <section class="mx-auto max-w-[90rem] px-5 py-24 md:px-10">
    <SectionHeading title="Kata mereka" />
    <div class="mt-14 grid gap-8 md:grid-cols-3 md:gap-10" data-stagger>
      {testimonials.map((t) => (
        <figure class="flex h-full flex-col border-t border-line pt-6">
          <span class="font-display text-4xl leading-none text-accent" aria-hidden="true">“</span>
          <blockquote class="mt-3 flex-1 font-display text-xl font-medium leading-snug md:text-2xl">
            {t.quote}
          </blockquote>
          <figcaption class="mt-6 text-sm">
            <span class="font-semibold">{t.name}</span>
            <span class="mt-0.5 block text-muted">{t.role}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

</Layout>
