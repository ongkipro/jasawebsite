---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
import ClientAuth from '@/components/islands/ClientAuth';
import Check from '@lucide/astro/icons/check';

const benefits = [
  'Pantau progress project realtime',
  'Lihat & unduh invoice kapan saja',
  'Semua update di satu tempat',
];
---

<Layout title="Daftar — JASAWEBSITE.co" description="Buat akun portal client JASAWEBSITE.co — pantau progress project & invoice." hideFooter>
  <section class="mx-auto grid min-h-[calc(100svh-6rem)] max-w-[90rem] px-5 md:grid-cols-2 md:px-10">
    <div class="flex flex-col justify-center py-14 md:pr-16">
      <p class="text-xs uppercase tracking-[0.25em] text-accent">Portal Client</p>
      <h1 class="mt-4 max-w-md font-display text-[clamp(2rem,4.5vw,3.5rem)] font-semibold leading-[1.04] tracking-tight">
        Mulai pantau project Anda.
      </h1>
      <p class="mt-4 max-w-sm text-muted">Satu akun untuk melihat progress &amp; invoice — kapan saja, di mana saja.</p>
      <ul class="mt-8 space-y-3">
        {benefits.map((x) => (
          <li class="flex items-center gap-3 text-muted">
            <Check class="h-4 w-4 shrink-0 text-accent" stroke-width={2.5} />
            {x}
          </li>
        ))}
      </ul>
    </div>

    <div class="flex items-center border-t border-line py-14 md:border-l md:border-t-0 md:pl-16">
      <ClientAuth client:load initialMode="register" />
    </div>
  </section>
</Layout>
