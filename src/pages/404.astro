---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';

const links = [
  { href: '/layanan', label: 'Layanan' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/stories', label: 'Cerita' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/kontak', label: 'Kontak' },
];
---

<Layout title="404 — Halaman tidak ditemukan" hideFooter mainClass="">
  <!-- Satu layar penuh, latar cream (= footer), adaptif & tanpa scroll di semua device -->
  <section
    class="flex min-h-[100svh] flex-col items-center justify-center gap-6 bg-[#f9f6f5] px-5 pb-10 pt-20 text-center sm:gap-8 [@media(max-height:560px)]:gap-4 [@media(max-height:560px)]:pt-16"
  >
    <img
      src="/footer-desk.gif"
      alt="Ilustrasi sedang bekerja"
      width="280"
      height="220"
      class="h-auto w-auto max-h-[30vh] max-w-[min(240px,58vw)] object-contain [@media(max-height:560px)]:hidden"
      onerror="this.style.display='none'"
    />

    <div class="flex flex-col items-center gap-3">
      <p class="text-xs uppercase tracking-[0.25em] text-muted">404 — Halaman tidak ditemukan</p>
      <h1
        class="font-display text-[clamp(2rem,5.5vw,3.75rem)] font-semibold leading-[1.04] tracking-tight"
        data-split-hero
      >
        Masih kami kerjakan.
      </h1>
      <p class="max-w-md text-base text-muted sm:text-lg">
        Halaman yang kamu cari belum ada atau lagi kami garap. Pilih menu lain di bawah 👇
      </p>
    </div>

    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:gap-x-7" aria-label="Menu utama">
      {links.map((l) => (
        <a
          href={l.href}
          class="group inline-flex items-baseline gap-1 font-display text-base font-semibold transition-colors hover:text-accent sm:text-lg md:text-xl"
        >
          {l.label}
          <span class="text-sm opacity-0 transition-opacity duration-300 group-hover:opacity-100" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  </section>
</Layout>
