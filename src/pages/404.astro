---
export const prerender = true;

import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 — Halaman tidak ditemukan">
  <section class="mx-auto flex max-w-4xl flex-col items-center px-5 py-32 text-center">
    <p class="font-display text-[8rem] font-semibold leading-none text-accent">404</p>
    <h1 class="mt-4 font-display text-2xl font-semibold">Halaman ini belum kami buat.</h1>
    <p class="mt-3 max-w-md text-muted">
      Tapi website impian Anda? Itu bisa kami buat. 😉
    </p>
    <div class="mt-8 flex gap-4">
      <a href="/" class="rounded-full border border-surface px-6 py-3 hover:border-accent hover:text-accent">
        Kembali ke Home
      </a>
      <a href="/portfolio" class="rounded-full bg-accent px-6 py-3 font-medium text-bg">
        Lihat Karya
      </a>
    </div>
  </section>
</Layout>
