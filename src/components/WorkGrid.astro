---
// Grid masonry portofolio — konfigurasi layout (rasio/offset/geser) terkunci di
// satu tempat, di-cycle via modulo agar presisi untuk jumlah karya berapa pun.
import type { Work } from '@/data/site';
import WorkCard from './WorkCard.astro';

interface Props {
  works: Work[];
}
const { works } = Astro.props;

const ratios = [
  'aspect-[3/4]', 'aspect-square', 'aspect-[4/5]', 'aspect-[5/4]', 'aspect-[4/3]',
  'aspect-[3/4]', 'aspect-[4/5]', 'aspect-square', 'aspect-[5/4]', 'aspect-[3/4]',
  'aspect-[4/3]', 'aspect-[4/5]', 'aspect-square', 'aspect-[4/5]', 'aspect-[5/4]',
];
const tops = [
  '', 'md:mt-16', 'md:mt-6', 'md:mt-24', '', 'md:mt-10', 'md:mt-20', 'md:mt-4',
  'md:mt-14', '', 'md:mt-24', 'md:mt-8', 'md:mt-16', 'md:mt-6', 'md:mt-20',
];
const nudge = [-10, 6, 0, 12, -6, 8, -4, 10, 0, -12, 6, 4, -8, 10, -5];
---

<div class="mt-16 gap-x-6 [column-fill:balance] sm:columns-2 sm:gap-x-8 lg:columns-3 lg:gap-x-10">
  {works.map((work, i) => (
    <WorkCard
      work={work}
      ratio={ratios[i % ratios.length]}
      offset={tops[i % tops.length]}
      nudge={nudge[i % nudge.length]}
    />
  ))}
</div>
