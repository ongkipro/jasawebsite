---
// Hero halaman dengan background video (konsep sama seperti hero homepage).
// `video` default /hero.mp4 — nanti tiap halaman bisa pakai video sendiri.
interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
  video?: string;
  cursor?: string;
}
const { title, eyebrow, intro, video = '/hero.mp4', cursor } = Astro.props;
---

<section class="mx-auto max-w-[90rem] px-5 pt-4 md:px-10" data-cursor={cursor}>
  <div class="hero-stage relative flex min-h-[46vh] flex-col justify-end overflow-hidden rounded-2xl md:min-h-[56vh] md:rounded-3xl">
    <video
      src={video}
      poster="/hero-poster.webp"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      class="absolute inset-0 h-full w-full scale-125 object-cover"
      data-parallax="0.15"></video>
    <div class="hero-scrim-strong absolute inset-0"></div>

    <div class="relative p-6 pb-8 md:p-12 md:pb-14">
      {eyebrow && <p class="text-xs uppercase tracking-[0.25em] text-accent">{eyebrow}</p>}
      <h1
        class="mt-3 max-w-4xl font-display text-[clamp(2.5rem,6vw,4.5rem)] font-semibold leading-[1.02] tracking-tight"
        data-split-hero
      >
        {title}
      </h1>
      {intro && <p class="mt-5 max-w-xl text-lg text-text/80" data-reveal>{intro}</p>}
    </div>
  </div>
</section>
