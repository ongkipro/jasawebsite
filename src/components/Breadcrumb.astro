---
// Breadcrumb visible + presisi. JSON-LD BreadcrumbList di-handle di masing-masing halaman.
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
  {items.map((c, i) => (
    <span class="flex items-center gap-2">
      {i > 0 && <span aria-hidden="true" class="text-line">/</span>}
      {c.href ? (
        <a href={c.href} class="transition-colors hover:text-accent">{c.label}</a>
      ) : (
        <span class="text-text">{c.label}</span>
      )}
    </span>
  ))}
</nav>
