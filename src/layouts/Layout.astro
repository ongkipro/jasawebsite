---
import { ClientRouter } from 'astro:transitions';
import { site, waLink } from '@/data/site';
import SmoothScroll from '@/components/islands/SmoothScroll';
import NavMenu from '@/components/islands/NavMenu';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean; // sembunyikan footer (mis. halaman 404 satu layar)
  mainClass?: string; // override kelas <main> (default pt-24 untuk clearance header)
  ogImage?: string; // gambar share per-halaman (default /og.png)
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  hideFooter = false,
  mainClass = 'pt-24',
  ogImage = '/og.png',
} = Astro.props;
const wa = waLink(Astro.locals.runtime?.env?.WHATSAPP_NUMBER ?? '6282136093430');

const year = new Date().getFullYear();

const nav = [
  { href: '/layanan', label: 'Layanan' },
  { href: '/product', label: 'Signature' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/stories', label: 'Cerita' },
  { href: '/tentang', label: 'Tentang' },
  { href: '/kontak', label: 'Kontak' },
];

// JSON-LD: Organization + WebSite (PRD §19)
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://jasawebsite.co/#org',
      name: site.name,
      url: 'https://jasawebsite.co',
      email: site.email,
      description: site.description,
      areaServed: 'ID',
      logo: 'https://jasawebsite.co/og.png',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://jasawebsite.co/#website',
      url: 'https://jasawebsite.co',
      name: site.name,
      inLanguage: 'id-ID',
      publisher: { '@id': 'https://jasawebsite.co/#org' },
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fcfcfa" />

    <!-- Fonts self-hosted (woff2) — @font-face di global.css. Preload yang paling kritis. -->
    <link rel="preload" href="/fonts/clash-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="JASAWEBSITE.co" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <!-- Set html.js sebelum paint: matikan fallback marquee CSS & aktifkan cursor tanpa flash -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Header transparan → dapat latar halus setelah scroll (kontras di atas konten)
      const setScrolled = () => {
        const h = document.getElementById('site-header');
        if (h) h.dataset.scrolled = String(window.scrollY > 40);
      };
      addEventListener('scroll', setScrolled, { passive: true });
      addEventListener('astro:page-load', setScrolled);
      setScrolled();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-text focus:px-4 focus:py-2 focus:text-bg"
    >
      Langsung ke konten
    </a>

    <!-- Custom cursor (fine-pointer only; disabled via CSS on touch + reduced-motion) -->
    <div class="cursor" aria-hidden="true">
      <div class="cursor-dot"></div>
      <div class="cursor-ring"><span class="cursor-label"></span></div>
    </div>

    <SmoothScroll client:load transition:persist />

    <!-- Header minimal ala Hello Monday: logo kiri, burger kanan (overlay fullscreen) -->
    <header id="site-header" transition:persist class="site-header fixed top-0 z-[70] w-full">
      <div class="mx-auto flex max-w-[90rem] items-center justify-between px-5 py-4 md:px-10">
        <a href="/" class="site-logo relative z-[80] inline-flex items-center" aria-label={`${site.name} beranda`}>
          <span class="logo-mark logo-mark--lg" aria-hidden="true"></span>
        </a>
        <NavMenu client:load links={nav} email={site.email} wa={wa} />
      </div>
    </header>

    <main id="main" class={mainClass}>
      <slot />
    </main>

    <!-- Footer ala Hello Monday: ilustrasi kiri + kolom kontak berlabel kanan -->
    {!hideFooter && (
    <footer class="site-footer mt-32 border-t border-line">
      <div class="mx-auto max-w-[90rem] px-5 py-20 md:px-10 md:py-24">
        <div class="grid gap-12 md:grid-cols-[0.85fr_1.15fr] md:items-start md:gap-16">
          <!-- Kiri: ilustrasi footer -->
          <div class="foot-art" data-reveal>
            <img
              src="/footer-desk.gif"
              alt="Ilustrasi kerja malam menghadap jendela berbulan"
              width="500"
              height="394"
              loading="lazy"
              onerror="this.style.display='none'"
            />
          </div>

          <!-- Kanan: kolom kontak berlabel + lokasi + sosial -->
          <div class="flex flex-col justify-between gap-12">
            <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
              <div>
                <p class="foot-title">Mau kerja sama?</p>
                <p class="mt-2 text-muted">Mulai project baru</p>
                <a href={`mailto:${site.email}`} class="foot-link">{site.email}</a>
              </div>
              <div>
                <p class="foot-title">Sekadar menyapa?</p>
                <p class="mt-2 text-muted">Tanya-tanya dulu</p>
                <a href={wa} target="_blank" rel="noopener" class="foot-link">Chat WhatsApp ↗</a>
              </div>
              <div>
                <p class="foot-title">Kantor</p>
                <div class="mt-3 space-y-4">
                  <address class="not-italic">
                    <p class="font-display text-base font-semibold">London, UK</p>
                    <p class="mt-1 text-sm leading-relaxed text-muted">
                      71–75 Shelton Street, Covent Garden,<br />
                      London, United Kingdom, WC2H 9JQ
                    </p>
                  </address>
                  <address class="not-italic">
                    <p class="font-display text-base font-semibold">Surabaya, Indonesia</p>
                    <p class="mt-1 text-sm leading-relaxed text-muted">
                      Pertemuan offline oleh tim marketing<br />
                      (dengan perjanjian)
                    </p>
                  </address>
                </div>
              </div>
              <div>
                <p class="foot-title">Ikuti</p>
                <div class="mt-3 flex flex-col gap-1">
                  {/* TODO: ganti dengan akun sosial asli */}
                  <a href="#" class="foot-social">Instagram ↗</a>
                  <a href="#" class="foot-social">TikTok ↗</a>
                  <a href="#" class="foot-social">LinkedIn ↗</a>
                </div>
              </div>
            </div>

            <nav class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-6" aria-label="Navigasi footer">
              {nav.map((item) => (
                <a href={item.href} class="text-sm text-muted hover:text-text">{item.label}</a>
              ))}
              <a href="/masuk" class="text-sm text-muted hover:text-text">Masuk</a>
            </nav>
          </div>
        </div>

        <!-- Bottom bar: mark + kembali ke atas + copyright -->
        <div class="mt-16 flex flex-col items-center gap-6 border-t border-line pt-8 md:flex-row md:justify-between">
          <a href="/" class="inline-flex items-center" aria-label={`${site.name} beranda`}>
            <span class="logo-mark" aria-hidden="true"></span>
          </a>
          <button
            type="button"
            class="backtop order-first md:order-none"
            onclick="(window.__lenis&&window.__lenis.scrollTo(0,{duration:1.2}))||window.scrollTo({top:0,behavior:'smooth'})"
          >
            <span aria-hidden="true">↑</span> Kembali ke atas
          </button>
          <p class="text-sm text-muted">© {year} {site.name} {site.byline}</p>
        </div>
      </div>
    </footer>
    )}
  </body>
</html>
